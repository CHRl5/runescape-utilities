<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>RuneScape Utilities</title>
    <style>
      @import url("https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=IBM+Plex+Mono:wght@400;500&display=swap");

      :root {
        --bg: #0d1016;
        --bg-soft: #171d28;
        --ink: #eff4ff;
        --muted: #a5b2ca;
        --line: #2a3142;
        --accent: #54e4b5;
        --accent-warm: #ffbf69;
      }

      * { box-sizing: border-box; }

      body {
        margin: 0;
        font-family: "Space Grotesk", sans-serif;
        color: var(--ink);
        background:
          radial-gradient(1200px 800px at 10% -10%, #26425f 0%, transparent 60%),
          radial-gradient(900px 500px at 90% 0%, #2d2340 0%, transparent 50%),
          var(--bg);
        min-height: 100vh;
      }

      .layout {
        width: min(1100px, 92vw);
        margin: 0 auto;
        padding: 3rem 0 4rem;
      }

      .hero h1 {
        margin: 0;
        font-size: clamp(2rem, 5vw, 3.5rem);
        line-height: 1.05;
      }

      .eyebrow {
        display: inline-block;
        margin: 0 0 0.75rem;
        color: #7be7c4;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        font-size: 0.8rem;
      }

      .intro {
        max-width: 65ch;
        color: var(--muted);
        margin-top: 0.9rem;
      }

      .grid {
        margin-top: 1.4rem;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
        gap: 1rem;
      }

      .card {
        display: block;
        text-decoration: none;
        color: inherit;
        background: color-mix(in oklab, var(--bg-soft) 90%, black 10%);
        border: 1px solid var(--line);
        border-radius: 18px;
        padding: 1rem 1.1rem;
        transition: transform 160ms ease, border-color 160ms ease, box-shadow 160ms ease;
      }

      .card:hover {
        transform: translateY(-3px);
        border-color: color-mix(in oklab, var(--accent), var(--line) 65%);
        box-shadow: 0 12px 26px rgba(0, 0, 0, 0.25);
      }

      .card h2 {
        margin: 0;
        font-size: 1.2rem;
      }

      .card p {
        margin: 0.65rem 0 0;
        color: var(--muted);
      }

      .pill {
        display: inline-block;
        margin-top: 0.8rem;
        padding: 0.25rem 0.55rem;
        border: 1px solid color-mix(in oklab, var(--accent-warm), var(--line) 60%);
        border-radius: 99px;
        font-family: "IBM Plex Mono", monospace;
        font-size: 0.75rem;
        color: var(--accent-warm);
      }

      .footnote {
        margin-top: 1.3rem;
        color: var(--muted);
        font-size: 0.9rem;
      }
    </style>
  </head>
  <body>
    <main class="layout">
      <header class="hero">
        <p class="eyebrow">RuneScape Utilities</p>
        <h1>Tools Hub</h1>
        <p class="intro">
          A growing collection of focused RuneScape utilities. Start with mining, then expand into more skilling,
          combat, and economy tools.
        </p>
      </header>

      <section class="grid">
        <a class="card" href="/runescape-utilities/tools/mining-one-hit/">
          <h2>RS3 One-Hit Mining Calculator</h2>
          <p>
            Enter mining level, strength level, and pickaxe to see which rocks are guaranteed, possible, or not possible
            to one-hit.
          </p>
          <span class="pill">Live Tool</span>
        </a>
      </section>

      <p class="footnote">More tools can now be added as separate pages under /tools.</p>
    </main>
  </body>
</html>
